generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ═══════════════════════════════════════════════════════════════
// NEW: روش پرداخت رزرو
// ═══════════════════════════════════════════════════════════════
enum PaymentMethod {
  IN_PERSON
  ONLINE
}

// ═══════════════════════════════════════════════════════════════
// NEW: وضعیت رأی روی نظر
// ═══════════════════════════════════════════════════════════════
enum ReviewVoteKind {
  LIKE
  DISLIKE
}

model User {
  id         String   @id @default(uuid())
  email      String?  @unique
  phone      String?  @unique
  password   String?
  name       String?
  role       UserRole @default(CUSTOMER)
  nationalId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ownedBusinesses Business[]       @relation("BusinessOwner")
  bookings        Booking[]        @relation("CustomerBookings")
  businessLikes   BusinessLike[]
  reviews         BusinessReview[]
  reviewVotes     ReviewVote[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses Business[]

  @@map("categories")
}

model Business {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  address   String?
  phone     String?
  ownerId   String
  owner     User     @relation("BusinessOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  description String? @db.Text
  logoUrl     String?

  // ──── Location (Phase 18) ────
  province  String?
  city      String?
  latitude  Float?
  longitude Float?
  mapLink   String? @db.Text

  // ──── Social Media (Phase 18) ────
  socialMedia Json?

  // ──── Gallery Images ────
  images BusinessImage[]

  // ──── Foundation (Phase 15) ────
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  viewsCount    Int       @default(0)
  bookingsCount Int       @default(0)

  // ═══════════════════════════════════════════════════════════════
  // NEW: شمارنده لایک صفحه (برای نمایش سریع بدون COUNT join)
  // ═══════════════════════════════════════════════════════════════
  likesCount Int @default(0)

  staff         Staff[]
  services      Service[]
  bookings      Booking[]
  businessHours BusinessHour[]
  holidays      Holiday[]
  likes         BusinessLike[]
  reviews       BusinessReview[]

  @@index([categoryId])
  @@index([viewsCount])
  @@index([bookingsCount])
  @@index([likesCount])
  @@index([createdAt])
  @@map("businesses")
}

model BusinessImage {
  id         String   @id @default(uuid())
  url        String
  caption    String?
  sortOrder  Int      @default(0)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, sortOrder])
  @@map("business_images")
}

model Staff {
  id         String   @id @default(uuid())
  name       String
  email      String?
  phone      String?
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  services   StaffService[]
  bookings   Booking[]
  breaks     StaffBreak[]
  dateBreaks StaffDateBreak[] // ← این خط را

  @@map("staff")
}

model Service {
  id              String   @id @default(uuid())
  name            String
  description     String?
  durationMinutes Int
  price           Float
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staff    StaffService[]
  bookings Booking[]

  @@map("services")
}

model StaffService {
  id        String  @id @default(uuid())
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@map("staff_services")
}

model BusinessHour {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0=Saturday ... 6=Friday (Iran week)
  openTime   String // HH:MM format
  closeTime  String // HH:MM format
  createdAt  DateTime @default(now())

  @@map("business_hours")
}

model Holiday {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  reason     String?
  createdAt  DateTime @default(now())

  @@map("holidays")
}

model Booking {
  id                 String        @id @default(uuid())
  businessId         String
  business           Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId         String
  customer           User          @relation("CustomerBookings", fields: [customerId], references: [id])
  staffId            String?
  staff              Staff?        @relation(fields: [staffId], references: [id])
  serviceId          String?
  service            Service?      @relation(fields: [serviceId], references: [id])
  startTime          DateTime
  endTime            DateTime
  status             BookingStatus @default(PENDING)
  notes              String?
  cancellationReason String? // علت لغو توسط مشتری (حداقل ۱۰ کاراکتر)
  cancelledAt        DateTime? // زمان لغو (برای analytics)

  // ═══════════════════════════════════════════════════════════════
  // NEW: روش پرداخت (IN_PERSON default برای backwards compatibility)
  // ═══════════════════════════════════════════════════════════════
  paymentMethod PaymentMethod @default(IN_PERSON)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, startTime])
  @@index([staffId, startTime])
  @@index([customerId])
  @@index([serviceId])
  @@index([paymentMethod])
  @@map("bookings")
}

model OtpCode {
  id         String   @id @default(uuid())
  identifier String // email یا شماره تماس
  code       String // کد ۶ رقمی
  attempts   Int      @default(0)
  verified   Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@index([expiresAt])
  @@map("otp_codes")
}

// ═══════════════════════════════════════════════════════════════
// NEW: لایک صفحه کسب‌وکار (یک لایک per user)
// ═══════════════════════════════════════════════════════════════
model BusinessLike {
  id         String   @id @default(uuid())
  userId     String
  businessId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("business_likes")
}

// ═══════════════════════════════════════════════════════════════
// NEW: نظر مشتریان (با ستاره ۱-۵)
// ═══════════════════════════════════════════════════════════════
model BusinessReview {
  id         String   @id @default(uuid())
  businessId String
  userId     String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int // 1..5
  text       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  votes   ReviewVote[]
  replies ReviewReply[]

  @@index([userId, businessId]) // نظر چندگانه per user مجاز است
  @@index([businessId, createdAt])
  @@index([businessId, rating])
  @@map("business_reviews")
}

// ═══════════════════════════════════════════════════════════════
// NEW: رأی مفید / مفید نبود روی نظر (یک رأی per user per review)
// ═══════════════════════════════════════════════════════════════
model ReviewVote {
  id        String         @id @default(uuid())
  reviewId  String
  userId    String
  kind      ReviewVoteKind
  review    BusinessReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@map("review_votes")
}

// ═══════════════════════════════════════════════════════════════
// NEW: پاسخ صاحب کسب‌وکار به نظر (یک پاسخ per review)
// ═══════════════════════════════════════════════════════════════
model ReviewReply {
  id        String         @id @default(uuid())
  reviewId  String         @unique
  text      String         @db.Text
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  review    BusinessReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_replies")
}

// ═══════════════════════════════════════════════════════════════
// NEW: بازه‌های غیرقابل رزرو در سطح هر کارمند (تکرارشونده هفتگی)
// ═══════════════════════════════════════════════════════════════
model StaffBreak {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=Saturday ... 6=Friday (Iran week)
  startTime String // HH:MM format (وقت محلی)
  endTime   String // HH:MM format (وقت محلی)
  createdAt DateTime @default(now())

  @@index([staffId, dayOfWeek])
  @@map("staff_breaks")
}

// ═══════════════════════════════════════════════════════════════
// NEW: غیبت موردی کارمند در یک تاریخ خاص (جدا از الگوی هفتگی)
// مثال: «پس‌فردا ۱۰ تا ۱۱ باید بره بانک» — فقط همان روز بسته می‌شود
// ═══════════════════════════════════════════════════════════════
model StaffDateBreak {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date // تاریخ روز غیبت (wall date)
  startTime String // HH:MM
  endTime   String // HH:MM
  reason    String?
  createdAt DateTime @default(now())

  @@index([staffId, date])
  @@map("staff_date_breaks")
}
